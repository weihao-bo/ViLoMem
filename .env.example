# ========== Dataset Configuration ==========
# Root directory for all benchmark datasets
DATASET_ROOT_DIR=/path/to/your/datasets

# ========== OpenAI API Configuration ==========
# OpenAI-compatible endpoint (for GPT-4.1 and other models)
# Used by model names with "openai:" prefix (e.g., openai:gpt-4.1-mini)
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# ========== DashScope API Configuration (for Qwen models) ==========
# Used by model names with "qwen:" prefix (e.g., qwen:qwen2.5-vl-embedding)
# Also used for visual embedding in Visual Memory retrieval
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ========== Local vLLM Configuration (for local: prefix models) ==========
# Used by model names with "local:" prefix (e.g., local:qwen3-vl-8b-instruct)
LOCAL_VLLM_API_BASE=http://localhost:8000/v1
LOCAL_VLLM_API_KEY=not-needed

# ========== Local Embedding API Configuration ==========
# Used by text embedding model names with "local:" prefix (e.g., local:qwen3-embedding)
# Required for Logic Memory and Visual Memory text-based retrieval
LOCAL_EMBEDDING_BASE_URL=http://localhost:18500/v1
LOCAL_EMBEDDING_API_KEY=not-needed

# ========== Verification Configuration ==========
# LLM Judge model for fallback answer verification (when rule-based methods fail)
# Format: provider:model-name (e.g., openai:gpt-4.1-mini, qwen:qwen-plus)
VLMEVAL_JUDGE_MODEL=openai:gpt-4.1-mini

# ========== LangSmith Tracing (optional) ==========
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=vilomem-eval

# ========== Regional Configuration (optional) ==========
# Set to 'prc' or 'cn' for Chinese mainland endpoints (DashScope)
# Set to 'international' or 'en' for international endpoints
REGION=international
